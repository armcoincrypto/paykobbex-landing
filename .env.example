# Optional, privacy-preserving measurement (baked in at `next build` for NEXT_PUBLIC_* vars).
# Production: see committed `.env.production` (Plausible for pay.kobbex.com).
# Local override: copy to `.env.local` (gitignored).

# none | plausible | umami | cloudflare
NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible

# Plausible — https://plausible.io/docs/plausible-script
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pay.kobbex.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Umami — https://umami.is/docs
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Cloudflare Web Analytics — https://developers.cloudflare.com/analytics/web-analytics/
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
